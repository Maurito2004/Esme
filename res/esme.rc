// Recursos de Esme: ícono, manifiesto e información de versión.
// Se compila con tools\build-res.ps1 -> res\esme.res (lo enlaza .cargo\config.toml).
#include <winver.h>

1 ICON "esme.ico"
1 24 "esme.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,0,0
 PRODUCTVERSION 0,7,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "2c0a04b0"
        BEGIN
            VALUE "CompanyName", "Esme"
            VALUE "FileDescription", "Esme - barra dinamica para Windows"
            VALUE "FileVersion", "0.7.0"
            VALUE "InternalName", "esme"
            VALUE "LegalCopyright", "Uso personal"
            VALUE "OriginalFilename", "esme.exe"
            VALUE "ProductName", "Esme"
            VALUE "ProductVersion", "0.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x2c0a, 1200
    END
END
